[Unit]
Description=Verify ZFS storage before NAS service pre-start exports
RequiresMountsFor={% for mount in config_resolved.mounts %}"{{ mount.path }}" {% endfor %}

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/mount-guard{% for mount in config_resolved.mounts %} "{{ mount.path }}" "{{ mount.dataset }}"{% endfor %}

