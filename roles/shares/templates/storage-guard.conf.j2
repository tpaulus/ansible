[Unit]
Requires=shares-ready.service
After=shares-ready.service
RequiresMountsFor={% for mount in config_resolved.mounts %}"{{ mount.path }}" {% endfor %}

BindsTo={{ shares_mount_units.results | map(attribute='stdout') | join(' ') }}
After={{ shares_mount_units.results | map(attribute='stdout') | join(' ') }}

[Service]
ExecStartPre=/usr/local/libexec/mount-guard{% for mount in config_resolved.mounts %} "{{ mount.path }}" "{{ mount.dataset }}"{% endfor %}
