<?xml version="1.0" standalone="no"?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<service-group>
  <name replace-wildcards="yes">%h</name>
  <service><type>_smb._tcp</type><port>445</port></service>
  <service>
    <type>_device-info._tcp</type><port>0</port>
    <txt-record>model=RackMac</txt-record>
  </service>
{% set tm = config_resolved.smb | selectattr('time_machine') | list %}
{% if tm %}
  <service>
    <type>_adisk._tcp</type><port>9</port>
    <txt-record>sys=waMa=0,adVF=0x100</txt-record>
{% for share in tm %}
    <txt-record>dk{{ loop.index0 }}=adVN={{ share.name | e }},adVF=0x82</txt-record>
{% endfor %}
  </service>
{% endif %}
</service-group>
