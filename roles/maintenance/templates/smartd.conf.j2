{{ ansible_managed | comment }}
# No -m or -M: smartd reports to the journal, never to an MTA.
{% for disk in maintenance_disks %}
{% set schedule = disk.selftests | default(maintenance_smart_selftests) %}
{{ disk.path }}{{ (' -d ' ~ disk.device_type) if disk.device_type is defined else '' }} -a{{ (' -s ' ~ schedule) if schedule else '' }}
{% endfor %}
