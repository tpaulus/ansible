{{ ansible_managed | comment }}

// Match codenames rather than suites so Debian's stable/oldstable transition
// neither blocks updates nor opts hosts into a new distribution release.
Unattended-Upgrade::Origins-Pattern {
    "origin=${distro_id},codename=${distro_codename}";
    "origin=${distro_id},codename=${distro_codename}-security";
    "origin=${distro_id},codename=${distro_codename}-updates";
{% if ansible_facts['distribution'] == 'Ubuntu' %}
    "origin=${distro_id}ESMApps,codename=${distro_codename}-apps-security";
    "origin=${distro_id}ESM,codename=${distro_codename}-infra-security";
{% endif %}
};

// No package whitelist: include versioned kernels, metapackages and other updates.

// Automatically remove unused kernel packages
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";

// Automatically remove unused dependencies
Unattended-Upgrade::Remove-Unused-Dependencies "true";

// Enable scheduled automatic reboots except on K3s and storage hosts
{% set automatic_reboot = 'tags_k3s' not in group_names and 'device_roles_storage' not in group_names %}
Unattended-Upgrade::Automatic-Reboot "{{ automatic_reboot | ternary('true', 'false') }}";
{% if automatic_reboot %}
Unattended-Upgrade::Automatic-Reboot-Time "04:00";
{% endif %}

// Added safety measures
Unattended-Upgrade::MinimalSteps "true";
Unattended-Upgrade::InstallOnShutdown "false";