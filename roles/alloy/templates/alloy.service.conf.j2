# {{ ansible_managed }}
[Unit]
Requires=alloy-metrics-firewall.service
After=alloy-metrics-firewall.service systemd-journald.service

[Service]
ExecStart=
ExecStart=/usr/bin/alloy run --storage.path=/var/lib/alloy --stability.level=public-preview --server.http.listen-addr=0.0.0.0:{{ alloy_listen_port }} --server.http.enable-pprof=false --disable-reporting /etc/alloy/config.alloy
ExecStartPre=/usr/bin/alloy validate --stability.level=public-preview /etc/alloy/config.alloy
SupplementaryGroups=adm systemd-journal
UMask=0027
StateDirectory=alloy
StateDirectoryMode=0750
Restart=always
RestartSec=5s
TimeoutStopSec=90s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/alloy
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
